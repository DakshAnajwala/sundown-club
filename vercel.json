{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/parking", "destination": "/parking/", "permanent": false },
    { "source": "/racing", "destination": "/racing/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "https://parking-precision.vercel.app/api/:path" }
  ]
}
