{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/parking",
      "destination": "/parking/",
      "permanent": false
    },
    {
      "source": "/parking/privacy.html",
      "destination": "/privacy.html",
      "permanent": false
    },
    {
      "source": "/parking/terms.html",
      "destination": "/terms.html",
      "permanent": false
    },
    {
      "source": "/parking/notices.html",
      "destination": "/notices.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "/c/index.html"
    },
    {
      "source": "/api/:path((?!club/).*)",
      "destination": "https://parking-precision.vercel.app/api/:path"
    }
  ]
}
