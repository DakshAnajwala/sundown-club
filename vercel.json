{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/parking",
      "destination": "/parking/",
      "permanent": false
    },
    {
      "source": "/parking/privacy.html",
      "destination": "/privacy.html",
      "permanent": false
    },
    {
      "source": "/parking/terms.html",
      "destination": "/terms.html",
      "permanent": false
    },
    {
      "source": "/parking/notices.html",
      "destination": "/notices.html",
      "permanent": false
    }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/icons/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ],
  "crons": [
    { "path": "/api/club/push-run", "schedule": "0 17 * * *" }
  ],
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "/c/index.html"
    },
    {
      "source": "/api/:path((?!club/).*)",
      "destination": "https://parking-precision.vercel.app/api/:path"
    }
  ]
}
